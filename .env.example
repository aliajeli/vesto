# ---------------------------------------------------------------- دیتابیس
# مسیر فایل SQLite. برای PostgreSQL کافیست provider را در prisma/schema.prisma عوض کنید.
DATABASE_URL="file:./dev.db"

# ------------------------------------------------------------ کلیدهای امنیتی
# هر دو مقدار زیر را حتماً پیش از استقرار عوض کنید.
# تولید مقدار امن:  openssl rand -hex 32
AUTH_SECRET="CHANGE_ME_openssl_rand_hex_32"
PAYMENT_HMAC_SECRET="CHANGE_ME_openssl_rand_hex_32"

# ------------------------------------------------------------------- آدرس سایت
# در محیط عملیاتی آدرس دامنه واقعی با https قرار دهید.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ------------------------------------------------------- تنظیمات اختیاری پنل
# در صورت نیاز به مسیر مخفی اضافه برای پنل مدیریت
ADMIN_PATH_SECRET=""

# ---------------------------------------------------------------- درگاه پرداخت
# کلیدهای درگاه از پنل مدیریت (تنظیمات ← درگاه پرداخت) وارد می‌شوند
# و در دیتابیس ذخیره می‌گردند؛ نیازی به قرار دادن آن‌ها اینجا نیست.
